{
  "name": "dsh-plugins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A collection of DeepSeek Harness plugins, delivered as one bundle.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nullpoint333/dsh-plugins.git"
  },
  "homepage": "https://github.com/nullpoint333/dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/nullpoint333/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "opencode",
    "opencode-go",
    "quota",
    "usage"
  ],
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./opencode-go-usage": "./plugins/opencode-go-usage/index.js",
    "./opencode-go-usage/locale/*.json": "./plugins/opencode-go-usage/locale/*.json",
    "./opencode-go-usage/icon": "./plugins/opencode-go-usage/icon.svg",
    "./better-experience": "./plugins/better-experience/index.js",
    "./better-experience/locale/*.json": "./plugins/better-experience/locale/*.json",
    "./better-experience/icon": "./plugins/better-experience/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "plugins",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
